{
  "name": "kxc-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KXC 性能分析图表桌布 (Performance Analysis Workbench Canvas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
